rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isGroupOwner(groupId) {
      return signedIn()
        && firestore.get(/databases/(default)/documents/groups/$(groupId)).data.ownerId == request.auth.uid;
    }

    function isValidImage() {
      return request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /avatars/{uid}/{fileName} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && fileName.matches('profile\\..+')
        && isValidImage();
      allow delete: if isOwner(uid);
    }

    match /groups/{groupId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if isGroupOwner(groupId)
        && fileName.matches('profile\\..+')
        && isValidImage();
      allow delete: if isGroupOwner(groupId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
